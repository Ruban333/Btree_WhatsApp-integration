# Copy to .env. Leave WA_MODE=mock for local testing (no real WhatsApp messages are sent).
WA_MODE=mock
INSTITUTE_NAME=BTree Systems
DEFAULT_COUNTRY_CODE=91

# Your organisation's WhatsApp number with country code (the floating widget opens a chat with this number)
WHATSAPP_NUMBER=
# Public HTTPS URL of this server once tunnelled/deployed (used to show the webhook URL)
PUBLIC_URL=

# WA_MODE=openwa uses a self-hosted OpenWA gateway (unofficial: ban risk, use a spare number).
# Run it with: git clone https://github.com/rmyndharis/OpenWA && cd OpenWA && docker compose up -d
# then get the key: docker exec openwa-api cat /app/data/.api-key
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION=btree
OPENWA_WEBHOOK_SECRET=
# Seconds between broadcast messages (random jitter added). Keep >= 8 to lower ban risk.
OPENWA_SEND_DELAY=8
# URL OpenWA uses to reach this server. Leave empty to use PUBLIC_URL / the browser's host.
# If OpenWA runs in Docker and this server on the host: http://host.docker.internal:8000
OPENWA_CALLBACK_URL=

# AI auto-reply agent (Claude). Get a key at https://platform.claude.com, then switch it on in the AI Agent page.
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# Needed only when WA_MODE=cloud (Meta WhatsApp Cloud API)
WA_TOKEN=
WA_PHONE_ID=
WA_WABA_ID=
WA_VERIFY_TOKEN=btree-verify
WA_APP_SECRET=
